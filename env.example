# BROKE CAT BOT V10.1 — EVIDENCE RUNNER RADAR
TRADING_MODE=paper
PAPER_BANKROLL_USD=11
MAX_DAILY_LOSS_USD=3
MIN_SCORE=85
POLL_SECONDS=30
DATA_DIR=/data
HELIUS_API_KEY=

# LIVE EXECUTION
LIVE_TRADING_ACK=I_UNDERSTAND_REAL_FUNDS_ARE_AT_RISK
JUPITER_API_KEY=
BS58_PRIVATE_KEY=
EXPECTED_WALLET_ADDRESS=
MIN_SOL_RESERVE=0.003
MIN_TRADE_USD=5

# POSITION SIZING — V9.2 uses the whole current wallet as the sizing base
# and lets Broke Cat choose 5%-30% per approved setup. 30% is a hard code ceiling.
POSITION_SIZING_MODE=dynamic
DYNAMIC_MIN_POSITION_PCT=5
DYNAMIC_MAX_POSITION_PCT=30
DYNAMIC_MAX_POSITION_USD=0
MAX_POSITION_TO_LIQUIDITY_PCT=0.5
# Legacy/fallback modes only:
LIVE_POSITION_USD=2
TARGET_POSITION_PCT=3
MAX_POSITION_USD=100

# MEME-COIN EXIT ENGINE
HARD_STOP_PCT=35
TP1_GAIN_PCT=50
TP1_SELL_PCT=15
TP2_GAIN_PCT=100
TP2_SELL_PCT=20
TP3_GAIN_PCT=200
TP3_SELL_PCT=20
TP4_GAIN_PCT=400
TP4_SELL_PCT=20
MOON_BAG_PCT=25
MAX_EXIT_CHUNK_USD=100
POSITION_RISK_RECHECK_SECONDS=120

# EARLY / MOMENTUM DISCOVERY
MIN_LIQUIDITY_USD=3000
MIN_5M_VOLUME_USD=500
MIN_MARKET_CAP_USD=3000
MAX_MARKET_CAP_USD=100000000
EARLY_MAX_AGE_MINUTES=30
EARLY_MAX_MARKET_CAP_USD=150000
MOMENTUM_MIN_MARKET_CAP_USD=50000
WATCH_TOKEN_ADDRESSES=

# X POSTING
X_POSTING_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_IDLE_POSTING_ENABLED=true
X_IDLE_POST_HOURS=2

# X INTELLIGENCE — Bearer token is separate from posting OAuth credentials
X_BEARER_TOKEN=
X_INTEL_ENABLED=true
X_STREAM_ENABLED=false
# Cost guard: pre-launch radar is OFF by default because broad X searches can return many paid Post reads.
X_PRELAUNCH_RADAR_ENABLED=false
X_INTEL_POLL_SECONDS=900
# Viral checks: max 10 returned Posts, one search, cached for 10 minutes.
X_HYPE_CACHE_SECONDS=600
X_TOKEN_SEARCH_MAX_RESULTS=10
X_TOKEN_SEARCH_MAX_QUERIES=1
X_HYPE_MIN_LIQUIDITY_USD=500
# Only used if X_PRELAUNCH_RADAR_ENABLED=true
X_PRELAUNCH_MAX_RESULTS=10
X_PRELAUNCH_MAX_QUERIES=1
X_OFFICIAL_WATCH_ACCOUNTS=
X_PRELAUNCH_QUERY=("launching soon" OR "fair launch" OR "launch today" OR "contract address" OR "CA soon" OR "live now") (solana OR SOL)
VIRAL_SHORTLIST_PER_SCAN=1
VIRAL_BONUS_MAX=15

# ANALYTICS
ANALYTICS_EVERY_SCANS=10
TOP_REJECTED_KEEP=20
CANDIDATE_SEEN_COOLDOWN_SECONDS=120

# V9.2 multilingual X intelligence
X_MULTILINGUAL_INTEL_ENABLED=true
X_MULTILINGUAL_QUERY_GROUPS=4

# V9.3 Cross-platform runner feeds
CROSS_PLATFORM_RUNNER_ENABLED=true
CROSS_PLATFORM_BONUS_MAX=8
RUNNER_FEED_POLL_SECONDS=60
RUNNER_FEED_MAX_ADDRESSES=120

# Birdeye fresh listings (optional; requires key)
BIRDEYE_ENABLED=true
BIRDEYE_API_KEY=

# Bitquery Pump.fun launch feed (optional; requires OAuth API token)
BITQUERY_PUMPFUN_ENABLED=true
BITQUERY_API_TOKEN=

# GeckoTerminal new + trending pools (works keyless; rate-limited)
GECKOTERMINAL_ENABLED=true

# Telegram public-channel intelligence. Bot only receives channels where it is a member.
TELEGRAM_INTEL_ENABLED=true
TELEGRAM_INTEL_BOT_TOKEN=
TELEGRAM_INTEL_KEYWORDS=launch,ca,contract,live,pump,solana

# V9.4 Liquidity Intelligence Engine
LIQUIDITY_RECHECK_SECONDS=30
LIQUIDITY_WARNING_DROP_PCT=50
LIQUIDITY_DANGER_DROP_PCT=70
LIQUIDITY_CRITICAL_DROP_PCT=85
LIQUIDITY_CONFIRMATIONS_REQUIRED=3
LIQUIDITY_CRITICAL_CONFIRMATIONS_REQUIRED=2
LIQUIDITY_MIN_EXIT_EFFICIENCY_PCT=75
LIQUIDITY_CRITICAL_EXIT_EFFICIENCY_PCT=60
LIQUIDITY_CONFIRM_PRICE_DROP_PCT=-15
LIQUIDITY_MIN_BUY_SELL_RATIO=0.6


# V9.5 Rapid Runner Watchlist

# V9.7 trajectory-aware rapid watch (optional; defaults shown)

# V10.0 Wide Runner Radar — catches established movers, not just newborns
DISCOVERY_MAX_ADDRESSES=150
DISCOVERY_BATCH_SIZE=30
GECKO_TRENDING_PAGES=3
GECKO_NEW_PAGES=2
RUNNER_RADAR_ENABLED=true
RUNNER_RADAR_MIN_LIQUIDITY_USD=5000
RUNNER_RADAR_MIN_MARKET_CAP_USD=10000
RUNNER_RADAR_MAX_MARKET_CAP_USD=25000000
RUNNER_RADAR_MIN_5M_VOLUME_USD=1000
RUNNER_RADAR_MAX_AGE_MINUTES=1440
RUNNER_EVIDENCE_THRESHOLD=60
RUNNER_STRONG_EVIDENCE_THRESHOLD=75
RUNNER_MIN_TRADES_5M=20
RUNNER_MIN_OBSERVATION_SECONDS=45
RUNNER_SNAPSHOT_RETENTION_MINUTES=180

# Optional: direct Pump.fun trending discovery through CoinGecko Megafilter
COINGECKO_API_KEY=
COINGECKO_PLATFORM_TRENDING_ENABLED=true
PLATFORM_TREND_PRIORITY_BOOST=2500

# v10.4: Rapid Watch removed. Revisit only candidates scoring 68+ every 5 minutes.
REVISIT_SCORE_ENABLED=true
REVISIT_SCORE_THRESHOLD=68
REVISIT_SCORE_INTERVAL_SECONDS=300
REVISIT_SCORE_MAX_MINUTES=60
REVISIT_SCORE_MAX_TOKENS=50
